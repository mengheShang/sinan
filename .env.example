# 复制为 .env 后再填写。.env 不进 Git，Agent 也不读取它。
# 这里只放占位值，绝不写真实密钥。

# 运行模式：demo 使用假数据和录制的模型响应，无需 Google 账号或 API Key
SINAN_MODE=demo

# PostgreSQL（只在本机 Compose 网络内使用）
POSTGRES_USER=sinan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sinan
DATABASE_URL=postgresql+psycopg://sinan:change-me@db:5432/sinan

# 以下变量在 M1 之后才会用到，先保持为空
# 加密 OAuth 令牌的密钥
SINAN_ENCRYPTION_KEY=
# Google OAuth 客户端（只由你本人配置）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LLM 服务
LLM_API_KEY=
