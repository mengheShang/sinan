# Copy to .env and fill in. .env is never committed, and agents never read it.
# Only placeholder values here; never put real secrets in this file.

# Run mode: demo uses fake data and recorded model responses,
# with no Google account or API key needed
SINAN_MODE=demo

# PostgreSQL. Compose builds the in-container DATABASE_URL from these three values
POSTGRES_USER=sinan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sinan
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432

# Only used when running alembic or pytest directly on the host.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first
# and the connection takes about two minutes to time out
DATABASE_URL=postgresql+psycopg://sinan:change-me@127.0.0.1:5432/sinan
TEST_DATABASE_URL=postgresql+psycopg://sinan:change-me@127.0.0.1:5432/sinan

# Key for encrypting OAuth tokens at rest (AES-256-GCM). Required in live mode,
# unused in demo mode. Generate one yourself and keep it only in your own .env:
#   uv run python -m app.crypto
# Losing it means re-authorizing every account; changing it makes stored tokens unreadable.
SINAN_ENCRYPTION_KEY=

# Dashboard login (single user). All three are required in live mode. In demo
# mode, leave them empty and sign in as user "demo" with password "sinan-demo".
# The username is your choice: 1 to 64 characters, no spaces, case-sensitive.
# Generate the other two yourself and keep them only in your own .env:
#   uv run python -m app.auth hash     (asks for the password, prints its hash)
#   uv run python -m app.auth secret   (prints a random session secret)
# Changing any of them signs out every session.
SINAN_DASHBOARD_USERNAME=
SINAN_DASHBOARD_PASSWORD_HASH=
SINAN_SESSION_SECRET=

# Not used until later M1 Issues; leave empty for now
# Google OAuth client (configured by the user only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LLM service
LLM_API_KEY=
